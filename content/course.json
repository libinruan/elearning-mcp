{
 "title": "MCP Mastery",
 "title_zh": "MCP 精通之路",
 "subtitle": "Model Context Protocol for AI engineers — spec revision 2026-07-28",
 "spec_version": "2026-07-28",
 "source": "https://modelcontextprotocol.io/docs/2026-07-28/getting-started/intro",
 "sdk": "mcp 2.3.0",
 "modules": [
  {
   "n": 1,
   "title": "The big picture",
   "title_zh": "全局视角",
   "blurb": "What MCP is, the problem it solves, its participants and layers, and how the protocol is versioned.",
   "blurb_zh": "MCP 是什么、解决什么问题、有哪些参与者（Participants）与分层（Layers），以及协议如何进行版本管理（Versioning）。"
  },
  {
   "n": 2,
   "title": "The wire protocol",
   "title_zh": "协议底层",
   "blurb": "JSON-RPC messages, the stateless request model, discovery, transports and the cross-cutting patterns.",
   "blurb_zh": "JSON-RPC 消息、无状态（Stateless）请求模型、发现（Discovery）、传输（Transports）以及贯穿各处的通用模式。"
  },
  {
   "n": 3,
   "title": "Server primitives",
   "title_zh": "服务器原语",
   "blurb": "Tools, resources and prompts — the three things a server offers — plus completion, caching and subscriptions.",
   "blurb_zh": "工具（Tools）、资源（Resources）与提示模板（Prompts）——服务器提供的三类能力——外加补全（Completion）、缓存（Caching）与订阅（Subscriptions）。"
  },
  {
   "n": 4,
   "title": "Building servers",
   "title_zh": "构建服务器",
   "blurb": "Write servers with the Python SDK, design tools an LLM can use well, then test and debug them.",
   "blurb_zh": "用 Python SDK 编写服务器，设计大语言模型（LLM）好用的工具，然后测试并调试它们。"
  },
  {
   "n": 5,
   "title": "Clients & agent loops",
   "title_zh": "客户端与智能体循环",
   "blurb": "Client features, the LLM tool-use loop, multi round-trip requests, and hosts that scale to many servers.",
   "blurb_zh": "客户端特性（Client Features）、LLM 工具调用循环（Tool-use Loop）、多轮往返请求（Multi Round-Trip Requests），以及可扩展到众多服务器的宿主（Host）。"
  },
  {
   "n": 6,
   "title": "Security & authorization",
   "title_zh": "安全与授权",
   "blurb": "OAuth 2.1 for remote servers, the attacks MCP systems face, and running local servers safely.",
   "blurb_zh": "面向远程服务器的 OAuth 2.1、MCP 系统面临的攻击（Attacks），以及如何安全地运行本地服务器。"
  },
  {
   "n": 7,
   "title": "Extensions & ecosystem",
   "title_zh": "扩展与生态",
   "blurb": "The extension mechanism, Tasks, MCP Apps, Skills, auth extensions, the Registry, SDKs and the roadmap.",
   "blurb_zh": "扩展机制（Extension Mechanism）、Tasks、MCP Apps、技能（Skills）、授权扩展、注册中心（Registry）、SDK 与路线图（Roadmap）。"
  },
  {
   "n": 8,
   "title": "Capstone & career",
   "title_zh": "综合项目与求职",
   "blurb": "Build a complete agentic workflow on MCP, then rehearse production and system-design interviews.",
   "blurb_zh": "在 MCP 上构建一个完整的智能体工作流（Agentic Workflow），然后演练生产环境与系统设计（System Design）面试。"
  }
 ],
